# Copie para .env.local. Nunca faça commit do .env.local.

# Página (podem ficar expostas: a chave anon só lê vagas.bolsoes e chama vagas.publicar/agora)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no computador, na hora de aplicar as migrations (npm run db:aplicar). Nunca na Vercel.
# Use a URL do "Transaction pooler" (porta 6543) do painel do Supabase.
DATABASE_URL=

# Só para o simulador da ponte (npm run simular:ponte). O mesmo token vai no config.h do firmware.
TOKEN_CENTRAL=

# A chave service_role NÃO é usada neste projeto. Não a coloque aqui.

# Opcional: endereço que vai no QR code (/qr). Padrão: https://vagas.rubysistemas.com.br
NEXT_PUBLIC_ENDERECO_PUBLICO=
